# Used only by `npm run build:app` (the Android/iOS app). The app's page comes from the phone itself,
# so it needs the full address of the hosted game server. Use wss:// (secure) once the server is online.
# Example: VITE_SERVER_URL=wss://boomjet.onrender.com
VITE_SERVER_URL=wss://boomjet.onrender.com
